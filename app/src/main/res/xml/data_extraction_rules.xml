<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+ Auto Backup rules: settings, the home layout and the database
     (notes, tasks, habits, playlists) go to the user's own Google backup and
     to a new phone during device transfer. SL runs no server. -->
<data-extraction-rules>
    <cloud-backup>
        <include domain="sharedpref" path="." />
        <include domain="file" path="datastore/" />
        <include domain="database" path="." />
    </cloud-backup>
    <device-transfer>
        <include domain="sharedpref" path="." />
        <include domain="file" path="datastore/" />
        <include domain="database" path="." />
    </device-transfer>
</data-extraction-rules>
